# Public address used by the Mini Program. It must be HTTPS in production.
PUBLIC_BASE_URL=https://meeting-api.example.com
PORT=3000

# Get both values from the Mini Program administration console. Never commit AppSecret.
WECHAT_APP_ID=wx0000000000000000
WECHAT_APP_SECRET=replace-with-app-secret

# Created once, only when the database contains no administrator.
INITIAL_ADMIN_USERNAME=meeting-admin
INITIAL_ADMIN_PASSWORD=replace-with-a-password-of-at-least-12-characters

# Optional. Defaults to server/data/share-meeting.sqlite.
DATABASE_PATH=server/data/share-meeting.sqlite
